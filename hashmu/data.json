      "id": "MD5",
      "name": "MD5",
      "subtle": false,
      "insecure": true
    },
    {
      "id": "SHA-1",
      "name": "SHA-1",
      "subtle": true,
      "insecure": true
    },
    {
      "id": "SHA-256",
      "name": "SHA-256",
      "subtle": true
    },
    {
      "id": "SHA-384",
      "name": "SHA-384",
      "subtle": true
    },
    {
      "id": "SHA-512",
      "name": "SHA-512",
      "subtle": true
    }
  ],
  "formats": [
    {
      "id": "hex",
      "name": "Hex"
    },
    {
      "id": "base64",
      "name": "Base64"
    }
  ],
  "charsets": {
    "lowercase": "abcdefghijklmnopqrstuvwxyz",
    "uppercase": "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
    "digits": "0123456789",
    "symbols": "!@#$%^&*()-_=+[]{};:,.?/"
  },
  "generateTypes": [
    {
      "id": "password"
    },
    {
      "id": "key128",
      "bytes": 16
    },
    {
      "id": "key256",
      "bytes": 32
    },
    {
      "id": "key512",
      "bytes": 64
    },
    {
      "id": "token",
      "bytes": 32
    },
    {
      "id": "uuid"
    }
  ],
  "encodings": [
    {
      "id": "base64",
      "name": "Base64"
    },
    {
      "id": "base64url",
      "name": "Base64 URL"
    },
    {
      "id": "hex",
      "name": "Hex"
    },
    {
      "id": "url",
      "name": "URL"
    }
  ],
  "limits": {
    "maxFileMB": 512,
    "minIterations": 1000,
    "maxIterations": 5000000,
    "debounceMs": 200
  },
  "settings": {
    "defaults": {
      "format": "hex",
      "length": 20,
      "lowercase": true,
      "uppercase": true,
      "digits": true,
      "symbols": true,
      "iterations": 600000
    },
    "fields": [
      {
        "id": "format",
        "type": "select",
        "options": [
          {
            "value": "hex",
            "label": "Hex"
          },
          {
            "value": "base64",
            "label": "Base64"
          }
        ],
        "label": "set.format"
      },
      {
        "id": "length",
        "type": "range",
        "min": 8,
        "max": 128,
        "step": 1,
        "label": "set.length"
      },
      {
        "id": "lowercase",
        "type": "checkbox",
        "label": "set.lowercase"
      },
      {
        "id": "uppercase",
        "type": "checkbox",
        "label": "set.uppercase"
      },
      {
        "id": "digits",
        "type": "checkbox",
        "label": "set.digits"
      },
      {
        "id": "symbols",
        "type": "checkbox",
        "label": "set.symbols"
      },
      {
        "id": "iterations",
        "type": "select",
        "options": [
          {
            "value": 100000,
            "label": "100,000"
          },
          {
            "value": 310000,
            "label": "310,000"
          },
          {
            "value": 600000,
            "label": "600,000"
          },
          {
            "value": 1000000,
            "label": "1,000,000"
          }
        ],
        "label": "set.iterations",
        "hint": "set.iterations.hint"
      }
    ]
  },
  "languages": [
    {
      "code": "en-US",
      "name": "English",
      "dir": "ltr"
    },
    {
      "code": "zh-CN",
      "name": "简体中文",
      "dir": "ltr"
