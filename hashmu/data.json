{
  "name": {
    "en-US": "Hash{highlight} — hashing and cryptography in your browser",
    "zh-CN": "Hash{highlight} — 在浏览器中进行哈希和加密",
    "ar-SA": "Hash{highlight} — التجزئة والتشفير في متصفحك"
