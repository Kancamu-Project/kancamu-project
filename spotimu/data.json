  "settings": {
    "defaults": {
      "volume": 0.8,
      "shuffle": false,
      "repeat": "off"
    },
    "fields": [
      {
        "id": "volume",
        "type": "range",
        "min": 0,
        "max": 1,
        "step": 0.05,
        "label": "player.volume"
      },
      {
        "id": "shuffle",
        "type": "checkbox",
        "label": "player.shuffle"
      },
      {
        "id": "repeat",
        "type": "select",
        "optionsFrom": {
          "list": "repeatModes",
          "labelPrefix": "player.repeat."
        },
        "label": "set.repeat.label"
      }
    ]
  }
}
