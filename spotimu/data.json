{
  "name": {
    "en-US": "Spoti{highlight} — your music",
    "zh-CN": "Spoti{highlight} — 你的音乐",
    "ar-SA": "Spoti{highlight} — موسيقاك"
  },
  "brandColor": "#1cc93d",
  "storageFolder": "drivemu",
  "repeatModes": [
    "off",
    "all",
    "one"
  ],
  "limits": {
    "cacheSize": 3
  },
  "media": {
    "audio": [
      "mp3",
      "wav",
      "ogg",
      "m4a",
      "flac",
      "aac",
      "opus",
      "weba"
    ]
  },
  "mimeTypes": {
    "mp3": "audio/mpeg",
    "wav": "audio/wav",
    "ogg": "audio/ogg",
    "m4a": "audio/mp4",
    "flac": "audio/flac",
    "aac": "audio/aac",
    "opus": "audio/ogg",
    "weba": "audio/webm"
  },
  "languages": [
    {
      "code": "en-US",
      "name": "English",
      "dir": "ltr"
    },
    {
      "code": "zh-CN",
      "name": "简体中文",
      "dir": "ltr"
    },
    {
      "code": "ar-SA",
      "name": "العربية",
      "dir": "rtl"
    }
  ],
  "ui": {
