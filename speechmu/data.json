{
  "name": {
    "en-US": "Speech{highlight} — speech to text and text to speech in your browser",
    "zh-CN": "Speech{highlight} — 在浏览器中语音转文字和文字转语音",
    "ar-SA": "Speech{highlight} — كلام إلى نص ونص إلى كلام في متصفحك"
  },
  "brandColor": "#ef2142",
  "speechLanguages": [
    {
      "code": "en",
      "name": "English",
      "whisper": "english",
      "locale": "en-US",
      "mms": "eng",
      "dir": "ltr"
    },
    {
      "code": "zh",
      "name": "中文",
      "whisper": "chinese",
      "locale": "zh-CN",
      "mms": null,
      "dir": "ltr"
    },
    {
      "code": "ar",
      "name": "العربية",
      "whisper": "arabic",
      "locale": "ar-SA",
      "mms": "ara",
      "dir": "rtl"
    },
    {
      "code": "id",
      "name": "Indonesia",
      "whisper": "indonesian",
      "locale": "id-ID",
      "mms": null,
      "dir": "ltr"
    },
    {
      "code": "es",
      "name": "Español",
      "whisper": "spanish",
      "locale": "es-ES",
      "mms": "spa",
      "dir": "ltr"
    },
    {
      "code": "fr",
      "name": "Français",
      "whisper": "french",
      "locale": "fr-FR",
      "mms": "fra",
      "dir": "ltr"
    },
    {
      "code": "de",
      "name": "Deutsch",
      "whisper": "german",
      "locale": "de-DE",
      "mms": "deu",
      "dir": "ltr"
    },
    {
      "code": "ru",
      "name": "Русский",
      "whisper": "russian",
      "locale": "ru-RU",
      "mms": "rus",
      "dir": "ltr"
    }
  ],
  "models": [
    {
      "id": "tiny",
      "name": "Whisper tiny",
      "model": "Xenova/whisper-tiny",
      "dtype": "q8",
      "mb": 40,
      "hint": {
        "en-US": "smallest and fastest, about 40 MB, the least exact",
        "zh-CN": "最小最快，约 40 MB，准确度最低",
        "ar-SA": "الأصغر والأسرع، نحو 40 ميغابايت، الأقل دقة"
      }
    },
    {
      "id": "base",
      "name": "Whisper base",
      "model": "Xenova/whisper-base",
      "dtype": "q8",
      "mb": 80,
      "hint": {
        "en-US": "a good middle, about 80 MB",
        "zh-CN": "较均衡，约 80 MB",
        "ar-SA": "توازن جيد، نحو 80 ميغابايت"
      }
    },
    {
      "id": "small",
      "name": "Whisper small",
      "model": "Xenova/whisper-small",
      "dtype": "q8",
      "mb": 250,
      "hint": {
        "en-US": "the most exact, about 250 MB, slower",
        "zh-CN": "最准确，约 250 MB，速度较慢",
        "ar-SA": "الأدق، نحو 250 ميغابايت، أبطأ"
      }
    }
  ],
  "speech": {
    "modelTemplate": "Xenova/mms-tts-{code}",
    "dtype": "fp32",
    "name": "MMS"
  },
  "engine": {
    "device": "wasm",
    "chunkSeconds": 30,
    "strideSeconds": 5,
    "sampleRate": 16000
  },
  "settings": {
    "defaults": {
      "model": "base",
      "listen": "auto",
      "speak": "en"
    },
    "fields": [
      {
        "id": "speak",
        "type": "select",
        "optionsFrom": {
          "list": "speechLanguages",
          "value": "code",
          "label": "name"
        },
        "label": "set.speak.label"
      }
    ],
    "models": {
      "cache": "transformers-cache",
      "choose": "model",
      "list": "models",
      "repo": "model"
    },
    "panels": [
      "modelList"
    ]
  },
  "languages": [
    {
      "code": "en-US",
      "name": "English",
      "dir": "ltr"
    },
    {
      "code": "zh-CN",
      "name": "简体中文",
      "dir": "ltr"
    },
    {
      "code": "ar-SA",
      "name": "العربية",
      "dir": "rtl"
    }
  ],
  "ui": {
    "logo": {
      "en-US": "Speech<span class=\"highlight\">{highlight}</span>",
